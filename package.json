{
	"name": "wav-export-metadata-to-luau",
	"version": "1.0.0",
	"author": "hexa0",
	"main": "dist/index.js",
	"devDependencies": {
		"@types/bun": "^1.1.14"
	},
	"description": "export various wav metadata to a luau script & json file, i use this personally to grab markers from files i export from FL Studio",
	"license": "GPL-3.0",
	"scripts": {
		"build": "bun run build:windows && bun run build:linux && bun run build:linux-arm && bun run build:mac-arm && bun run build:bundle",
		"build:mac-arm": "bun build src/index.ts --compile --target=bun-darwin-arm64 --minify --sourcemap --outfile dist/macos/arm64/exportmarkers",
		"build:linux-arm": "bun build src/index.ts --compile --target=bun-linux-arm64 --minify --sourcemap --outfile dist/linux/arm64/exportmarkers",
		"build:linux": "bun build src/index.ts --compile --target=bun-linux-x64-modern  --minify --sourcemap --outfile dist/linux/amd64/exportmarkers",
		"build:windows": "bun build src/index.ts --compile --target=bun-windows-x64-modern --minify --sourcemap --windows-icon=src/appIcon.ico --outfile dist/windows/amd64/exportmarkers.exe",
		"build:windows-arm": "bun build src/index.ts --compile --target=bun-windows-arm64 --minify --sourcemap --windows-icon=src/appIcon.ico --outfile dist/windows/arm64/exportmarkers.exe",
		"build:bundle": "bun build src/index.ts --target=bun --minify --outfile dist/bundle.js",
		"dev": "bun --watch run src/index.ts samples/snd_place.wav"
	},
	"dependencies": {
		"luadata": "^1.0.2"
	}
}
